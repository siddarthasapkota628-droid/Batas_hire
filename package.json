{
  "name": "batas-project",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "cms"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:cms": "npm run dev --workspace=cms",
    "dev": "concurrently \"npm run dev:cms\" \"npm run dev:frontend\"",
    "build:frontend": "npm run build --workspace=frontend",
    "build:cms": "npm run build --workspace=cms",
    "build": "npm run build:cms && npm run build:frontend",
    "install:all": "npm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
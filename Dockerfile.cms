FROM node:20-alpine

# Enable pnpm
RUN corepack enable

WORKDIR /app

# Copy workspace files FIRST
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./

# Copy cms package.json
COPY cms/package.json cms/package.json

# Install deps (workspace-aware)
RUN pnpm install --frozen-lockfile

# Copy cms source
COPY cms ./cms

# Move into cms
WORKDIR /app/cms

EXPOSE 3000
CMD ["pnpm", "run", "dev"]

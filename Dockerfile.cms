FROM node:20-alpine
RUN corepack enable
WORKDIR /app

# 1. Copy workspace configs
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY cms/package.json ./cms/

# 2. Install production dependencies only
RUN pnpm install --shamefully-hoist --prod

# 3. Copy the cms source AND the already-built .next folder
COPY cms ./cms
# Ensure the .next folder from your host is copied over
COPY cms/.next ./cms/.next

WORKDIR /app/cms

ENV NODE_ENV=production
ENV PAYLOAD_CONFIG_PATH=src/payload.config.ts

# Use the direct path to the binary we found earlier
CMD ["node", "/app/node_modules/next/dist/bin/next", "start"]
